#!/usr/bin/env zsh

antidote_dir=~/.antidote
source $antidote_dir/antidote.zsh
antidote update

mise self-update -y

if [[ "$TERMINAL_OS" == "rhel" ]]; then
    mise bootstrap --upgrade --yes --skip user,packages
else
    mise bootstrap --upgrade --yes --skip user
fi

if (( $+commands[rustup] )); then
    rustup update
fi

if (( $+commands[cargo-install-update] )); then
    cargo install-update --all
fi

if [[ "$TERMINAL_OS" == "macos" ]]; then
    brew update
    brew upgrade
    brew upgrade --cask --greedy

elif [[ "$TERMINAL_OS" == "ubuntu" ]]; then
    sudo apt update && sudo apt upgrade && sudo apt autoremove

elif [[ "$TERMINAL_OS" == "debian" ]]; then
    sudo apt update && sudo apt upgrade && sudo apt autoremove

elif [[ "$TERMINAL_OS" == "fedora" ]]; then
    sudo dnf upgrade --refresh

elif [[ "$TERMINAL_OS" == "arch" ]]; then
    sudo pacman -Syu

fi
